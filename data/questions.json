[
  { "id": 1, "group": "nature", "cluster": "wilderness", "text": "I feel most at ease in places where I can't hear traffic.", "dimensions": { "nature": 2, "solitude": 2, "rural": 1, "urban": -2 } },
  { "id": 2, "group": "weather", "cluster": "weather", "text": "Rain and a low grey sky make a day better, not worse.", "dimensions": { "nature": 1, "melancholy": 2, "mystery": 1, "optimism": -1, "darkness": 1 } },
  { "id": 3, "group": "home", "cluster": "plants-indoors", "text": "A room with nothing living in it feels unfinished to me.", "dimensions": { "nature": 2, "organic": 2, "comfort": 1, "minimalism": -1 } },
  { "id": 4, "group": "nature", "cluster": "water", "text": "I'm drawn to coasts, rivers and lakes more than to open plains.", "dimensions": { "nature": 2, "adventure": 1, "mystery": 1, "melancholy": 1 } },
  { "id": 5, "group": "nature", "cluster": "nature-reclaims", "text": "I like places where nature is clearly present, even when the place was built for people.", "dimensions": { "nature": 2, "organic": 2, "chaos": 1, "order": -1, "architecture": 1 } },
  { "id": 6, "group": "nature", "cluster": "controlled-nature", "text": "Clipped hedges and symmetrical gardens are finer than a garden left to grow freely.", "dimensions": { "order": 2, "ornament": 1, "tradition": 1, "refinement": 1, "chaos": -2, "organic": -1 } },
  { "id": 7, "group": "weather", "cluster": "seasons-dark", "text": "Late autumn and early winter are my favourite seasons.", "dimensions": { "melancholy": 2, "nature": 1, "darkness": 1, "solitude": 1, "optimism": -1 } },
  { "id": 8, "group": "nature", "cluster": "animals", "text": "Knowing there are animals nearby that I can't see makes a place more interesting.", "dimensions": { "nature": 2, "mystery": 2, "fantasy": 1, "organic": 1 } },
  { "id": 9, "group": "nature", "cluster": "outdoor-comfort", "text": "I'd rather enjoy nature through a window, with the heating on.", "dimensions": { "comfort": 2, "nature": 1, "solitude": 1, "adventure": -2 } },
  { "id": 10, "group": "nature", "cluster": "wilderness", "text": "Untouched wilderness appeals to me more than a well-kept park.", "dimensions": { "nature": 2, "adventure": 2, "chaos": 1, "solitude": 1, "order": -2 } },
  { "id": 11, "group": "nature", "cluster": "growing", "text": "Growing something myself means more than buying it ready-made.", "dimensions": { "craft": 2, "nature": 2, "tradition": 1, "community": 1, "organic": 1 } },
  { "id": 12, "group": "city-country", "cluster": "city-energy", "text": "A big city gives me more energy than a walk in the woods.", "dimensions": { "urban": 3, "social": 2, "nature": -2, "solitude": -1, "modernity": 1 } },
  { "id": 13, "group": "style", "cluster": "materials-patina", "text": "Materials that wear well - wood, leather, stone - are finer than materials that stay pristine.", "dimensions": { "craft": 2, "organic": 2, "history": 1, "nostalgia": 1, "modernity": -2 } },
  { "id": 14, "group": "weather", "cluster": "light-grey", "text": "Soft grey daylight suits me better than bright sun.", "dimensions": { "melancholy": 2, "darkness": 1, "mystery": 1, "optimism": -2 } },
  { "id": 15, "group": "unexplained", "cluster": "hidden-landscape", "text": "Landscapes that hide something are more interesting than landscapes that show everything at once.", "dimensions": { "mystery": 3, "nature": 1, "fantasy": 1, "realism": -1 } },
  { "id": 16, "group": "travel", "cluster": "long-walk", "text": "I'd rather walk a long way alone than a short way with a crowd.", "dimensions": { "solitude": 3, "adventure": 2, "social": -2, "individualism": 1 } },
  { "id": 17, "group": "buildings", "cluster": "decay", "text": "Moss, lichen and decay on a building are beautiful, not ugly.", "dimensions": { "organic": 2, "history": 2, "chaos": 1, "mystery": 1, "modernity": -2, "order": -1 } },
  { "id": 18, "group": "nature", "cluster": "sea-fear", "text": "The sea frightens me more than it draws me in.", "dimensions": { "adventure": -2, "mystery": -1, "comfort": 1, "nature": -1 } },
  { "id": 19, "group": "home", "cluster": "indoor-life", "text": "I could happily live somewhere without a garden or a balcony.", "dimensions": { "nature": -2, "urban": 1, "minimalism": 1, "organic": -1 } },
  { "id": 20, "group": "home", "cluster": "fire", "text": "Open flame - a fire, a hearth, a candle - improves almost any place.", "dimensions": { "comfort": 2, "tradition": 1, "nature": 1, "nostalgia": 1, "darkness": 1 } },
  { "id": 21, "group": "home", "cluster": "shelter-storm", "text": "Being indoors during a storm, dry and safe, is one of the best feelings I know.", "dimensions": { "comfort": 3, "solitude": 2, "melancholy": 1, "nature": 1 } },
  { "id": 22, "group": "travel", "cluster": "uncomfortable-places", "text": "Places that are a little uncomfortable to be in can still be worth seeking out.", "dimensions": { "adventure": 2, "darkness": 1, "mystery": 1, "comfort": -2, "realism": 1 } },
  { "id": 23, "group": "city-country", "cluster": "village", "text": "I could be happy in a small village where everyone knows everyone.", "dimensions": { "rural": 3, "community": 2, "tradition": 1, "urban": -2, "individualism": -1 } },
  { "id": 24, "group": "city-country", "cluster": "city-parks", "text": "The parks are the best thing about a city.", "dimensions": { "nature": 2, "urban": 1, "organic": 1, "comfort": 1 } },
  { "id": 25, "group": "weather", "cluster": "summer-light", "text": "Long, light summer evenings are my favourite mood.", "dimensions": { "optimism": 2, "social": 1, "nature": 1, "melancholy": -1, "darkness": -2 } },
  { "id": 26, "group": "nature", "cluster": "food-origin", "text": "Food tastes better when I know where it came from.", "dimensions": { "tradition": 1, "craft": 2, "nature": 1, "community": 1, "rural": 1 } },
  { "id": 27, "group": "people", "cluster": "silence", "text": "Silence is something I seek out, not something I need to fill.", "dimensions": { "solitude": 3, "minimalism": 1, "social": -1, "melancholy": 1 } },
  { "id": 28, "group": "past", "cluster": "old-places", "text": "I'm drawn more to places with a visible connection to the past than to places that are new and perfect.", "dimensions": { "history": 3, "nostalgia": 2, "modernity": -2, "architecture": 1 } },
  { "id": 29, "group": "past", "cluster": "secondhand", "text": "Second-hand shops and flea markets are more exciting than new shops.", "dimensions": { "nostalgia": 2, "history": 2, "craft": 1, "maximalism": 1, "modernity": -2 } },
  { "id": 30, "group": "tradition", "cluster": "inherited", "text": "Things I've inherited mean more to me than things I've bought.", "dimensions": { "tradition": 2, "history": 2, "nostalgia": 2, "community": 1, "individualism": -1 } },
  { "id": 31, "group": "past", "cluster": "no-nostalgia", "text": "I rarely miss the way things used to be.", "dimensions": { "nostalgia": -3, "modernity": 2, "futurism": 1, "tradition": -1 } },
  { "id": 32, "group": "past", "cluster": "old-photos", "text": "Old photographs of people I never knew can move me.", "dimensions": { "nostalgia": 3, "melancholy": 2, "history": 2, "mystery": 1 } },
  { "id": 33, "group": "tradition", "cluster": "rituals-tradition", "text": "Traditions are worth keeping alive even when nobody remembers why they started.", "dimensions": { "tradition": 3, "history": 1, "community": 1, "mystery": 1, "modernity": -1 } },
  { "id": 34, "group": "past", "cluster": "old-media", "text": "The films and music I like best were made before I was born.", "dimensions": { "retro": 3, "nostalgia": 2, "history": 1, "modernity": -1 } },
  { "id": 35, "group": "future", "cluster": "new-looks-new", "text": "New technology should look new, not imitate something old.", "dimensions": { "modernity": 2, "futurism": 2, "retro": -2, "nostalgia": -1, "minimalism": 1 } },
  { "id": 36, "group": "buildings", "cluster": "old-house", "text": "A house with history is worth the crooked floors.", "dimensions": { "history": 3, "tradition": 1, "craft": 1, "comfort": -1, "order": -1, "architecture": 1 } },
  { "id": 37, "group": "future", "cluster": "future-different", "text": "I like the thought that the future will be nothing like now.", "dimensions": { "futurism": 3, "optimism": 1, "modernity": 2, "tradition": -2 } },
  { "id": 38, "group": "tradition", "cluster": "past-meaning", "text": "The way people lived a hundred years ago seems more meaningful than the way we live now.", "dimensions": { "tradition": 2, "history": 2, "nostalgia": 2, "melancholy": 1, "modernity": -2, "futurism": -1 } },
  { "id": 39, "group": "screens", "cluster": "childhood-tech", "text": "I get genuinely nostalgic about technology I used as a child.", "dimensions": { "nostalgia": 3, "retro": 2, "digital": 2, "technology": 1 } },
  { "id": 40, "group": "past", "cluster": "museums", "text": "Museums are among the best places I know.", "dimensions": { "history": 3, "intellect": 2, "order": 1, "refinement": 1 } },
  { "id": 41, "group": "unexplained", "cluster": "true-story", "text": "I'd rather have a story that's true than one that's beautiful.", "dimensions": { "realism": 3, "intellect": 1, "fantasy": -2, "ornament": -1 } },
  { "id": 42, "group": "past", "cluster": "archives", "text": "Old maps, letters and diaries fascinate me.", "dimensions": { "history": 3, "mystery": 2, "intellect": 2, "nostalgia": 1 } },
  { "id": 43, "group": "buildings", "cluster": "new-apartment", "text": "I'd rather live in a new-build flat than in an old tenement.", "dimensions": { "modernity": 3, "order": 2, "comfort": 1, "history": -2, "nostalgia": -1 } },
  { "id": 44, "group": "temperament", "cluster": "disappearing", "text": "There's something sad but beautiful about things that are on their way out.", "dimensions": { "melancholy": 3, "history": 2, "nostalgia": 2, "darkness": 1 } },
  { "id": 45, "group": "craft-tools", "cluster": "paper", "text": "Handwriting, letters and physical books have a value screens can't replace.", "dimensions": { "craft": 2, "tradition": 2, "nostalgia": 2, "digital": -2, "intellect": 1 } },
  { "id": 46, "group": "past", "cluster": "layered-time", "text": "I like places where several eras are visible at once.", "dimensions": { "history": 2, "maximalism": 2, "chaos": 1, "mystery": 1, "architecture": 1 } },
  { "id": 47, "group": "past", "cluster": "not-keeping", "text": "I feel little need to keep things just because they're old.", "dimensions": { "history": -2, "nostalgia": -2, "modernity": 2, "minimalism": 2 } },
  { "id": 48, "group": "tradition", "cluster": "ancestry", "text": "Stories about people who lived before me give me a sense of belonging.", "dimensions": { "history": 2, "community": 2, "tradition": 2, "nostalgia": 1 } },
  { "id": 49, "group": "future", "cluster": "tech-wonder", "text": "I get genuinely excited when I see something technological that feels like magic.", "dimensions": { "technology": 3, "futurism": 2, "optimism": 2, "fantasy": 1 } },
  { "id": 50, "group": "screens", "cluster": "old-internet", "text": "The internet was better when it was messy and amateur.", "dimensions": { "digital": 2, "nostalgia": 3, "retro": 2, "chaos": 2, "order": -2, "individualism": 1 } },
  { "id": 51, "group": "screens", "cluster": "invisible-tech", "text": "I'd rather technology stayed invisible in my daily life.", "dimensions": { "minimalism": 2, "order": 1, "nature": 1, "technology": -1, "maximalism": -1 } },
  { "id": 52, "group": "craft-tools", "cluster": "visible-mechanism", "text": "I like machines where I can see how they work.", "dimensions": { "craft": 3, "industrial": 2, "technology": 2, "ornament": 1, "intellect": 1 } },
  { "id": 53, "group": "future", "cluster": "future-fear", "text": "The future feels more frightening than exciting.", "dimensions": { "futurism": -2, "melancholy": 2, "darkness": 2, "optimism": -3 } },
  { "id": 54, "group": "future", "cluster": "tech-nature-union", "text": "I believe technology and nature can amount to something greater together.", "dimensions": { "technology": 2, "nature": 2, "organic": 2, "futurism": 2, "optimism": 2 } },
  { "id": 55, "group": "screens", "cluster": "screens-night", "text": "Screens and lights at night give me a safe, homely feeling.", "dimensions": { "digital": 3, "urban": 1, "comfort": 2, "solitude": 1, "darkness": 1 } },
  { "id": 56, "group": "craft-tools", "cluster": "hand-tools", "text": "I prefer tools made of metal and wood to tools that come with an app.", "dimensions": { "craft": 3, "tradition": 2, "digital": -2, "technology": -1, "realism": 1 } },
  { "id": 57, "group": "craft-tools", "cluster": "machines-beauty", "text": "Big machines, cranes and factories have a beauty of their own.", "dimensions": { "industrial": 3, "urban": 1, "realism": 1, "adventure": 1, "architecture": 1 } },
  { "id": 58, "group": "screens", "cluster": "old-computers", "text": "I like the look of old computers and older interfaces.", "dimensions": { "retro": 3, "digital": 3, "nostalgia": 2, "technology": 1 } },
  { "id": 59, "group": "values", "cluster": "function-over-form", "text": "I'd rather have a car that's reliable than one that's beautiful.", "dimensions": { "realism": 2, "comfort": 1, "ornament": -2, "refinement": -1 } },
  { "id": 60, "group": "future", "cluster": "progress", "text": "On balance, the world is slowly getting better.", "dimensions": { "optimism": 3, "futurism": 2, "modernity": 1, "melancholy": -2, "darkness": -1 } },
  { "id": 61, "group": "future", "cluster": "bright-scifi", "text": "I prefer science fiction that imagines a bright, clean future to one that imagines a dark, ruined one.", "dimensions": { "futurism": 2, "optimism": 3, "minimalism": 1, "order": 1, "darkness": -2 } },
  { "id": 62, "group": "screens", "cluster": "unavailable", "text": "I miss a time when you weren't reachable all the time.", "dimensions": { "nostalgia": 2, "solitude": 2, "digital": -2, "social": -1, "tradition": 1 } },
  { "id": 63, "group": "city-country", "cluster": "neon-night", "text": "Artificial light, reflections and wet asphalt at night are beautiful.", "dimensions": { "urban": 3, "digital": 2, "darkness": 2, "mystery": 2, "nature": -1 } },
  { "id": 64, "group": "craft-tools", "cluster": "how-things-work", "text": "I enjoy reading about how things are built and why they work.", "dimensions": { "intellect": 3, "technology": 2, "craft": 1, "realism": 1 } },
  { "id": 65, "group": "craft-tools", "cluster": "simple-solutions", "text": "I trust simple, old-fashioned solutions most.", "dimensions": { "tradition": 3, "craft": 2, "realism": 2, "futurism": -2, "technology": -1 } },
  { "id": 66, "group": "craft-tools", "cluster": "modding", "text": "Rebuilding, repairing and modifying things myself is something I enjoy.", "dimensions": { "craft": 3, "individualism": 2, "industrial": 1, "chaos": 1, "technology": 1 } },
  { "id": 67, "group": "craft-tools", "cluster": "built-to-last", "text": "There's something beautiful about things made to last a hundred years.", "dimensions": { "craft": 2, "tradition": 2, "order": 1, "refinement": 1, "history": 1 } },
  { "id": 68, "group": "screens", "cluster": "digital-space", "text": "A digital space can feel as real as a physical place.", "dimensions": { "digital": 3, "fantasy": 2, "technology": 2, "realism": -1 } },
  { "id": 69, "group": "screens", "cluster": "update-fatigue", "text": "Having to keep up with new platforms and updates wears me out.", "dimensions": { "digital": -2, "modernity": -2, "tradition": 2, "comfort": 1, "futurism": -1 } },
  { "id": 70, "group": "buildings", "cluster": "concrete", "text": "Raw concrete can be as beautiful as marble.", "dimensions": { "industrial": 3, "minimalism": 2, "realism": 2, "architecture": 2, "ornament": -2 } },
  { "id": 71, "group": "buildings", "cluster": "detail-decoration", "text": "Detail and ornament make a building better, not busier.", "dimensions": { "ornament": 3, "maximalism": 2, "tradition": 1, "refinement": 2, "minimalism": -2, "architecture": 2 } },
  { "id": 72, "group": "home", "cluster": "low-dark-rooms", "text": "I feel best in rooms with low ceilings and little light.", "dimensions": { "comfort": 2, "solitude": 2, "darkness": 2, "mystery": 1, "architecture": 1 } },
  { "id": 73, "group": "buildings", "cluster": "glass-open", "text": "Large windows and open floor plans are my ideal.", "dimensions": { "modernity": 3, "minimalism": 2, "order": 2, "optimism": 1, "architecture": 2, "darkness": -1 } },
  { "id": 74, "group": "home", "cluster": "full-home", "text": "A home should be full of things you love, not stripped back to the essentials.", "dimensions": { "maximalism": 3, "comfort": 2, "nostalgia": 1, "minimalism": -3, "ornament": 1 } },
  { "id": 75, "group": "buildings", "cluster": "building-detail-eye", "text": "I notice how buildings meet the ground and the sky.", "dimensions": { "architecture": 3, "intellect": 2, "refinement": 1 } },
  { "id": 76, "group": "city-country", "cluster": "winding-streets", "text": "Narrow, winding streets have more charm than wide, planned ones.", "dimensions": { "history": 2, "chaos": 2, "mystery": 2, "urban": 2, "order": -2 } },
  { "id": 77, "group": "order", "cluster": "symmetry", "text": "Symmetry calms me.", "dimensions": { "order": 3, "refinement": 2, "minimalism": 1, "chaos": -2 } },
  { "id": 78, "group": "buildings", "cluster": "vernacular", "text": "I like buildings that look like they belong where they stand.", "dimensions": { "organic": 2, "tradition": 2, "craft": 1, "architecture": 2, "rural": 1 } },
  { "id": 79, "group": "home", "cluster": "bare-room", "text": "A room with only the essentials in it feels free, not empty.", "dimensions": { "minimalism": 3, "order": 2, "modernity": 1, "maximalism": -3, "ornament": -1 } },
  { "id": 80, "group": "unexplained", "cluster": "abandoned", "text": "I'm drawn to abandoned buildings.", "dimensions": { "mystery": 3, "history": 2, "darkness": 2, "melancholy": 2, "adventure": 2, "modernity": -1 } },
  { "id": 81, "group": "city-country", "cluster": "skyscrapers", "text": "Towers and skyscrapers give me a sense of possibility.", "dimensions": { "urban": 3, "modernity": 2, "futurism": 2, "optimism": 1, "architecture": 1, "rural": -1 } },
  { "id": 82, "group": "home", "cluster": "home-as-cave", "text": "I want a home that feels like a den, not a display case.", "dimensions": { "comfort": 3, "solitude": 2, "darkness": 1, "refinement": -1, "minimalism": -1 } },
  { "id": 83, "group": "buildings", "cluster": "institutions", "text": "Institutional buildings - libraries, universities, old schools - have a particular pull on me.", "dimensions": { "intellect": 3, "history": 2, "tradition": 2, "architecture": 2, "refinement": 1, "order": 1 } },
  { "id": 84, "group": "style", "cluster": "clash-interior", "text": "I like interiors where colours, patterns and eras collide.", "dimensions": { "maximalism": 3, "chaos": 2, "whimsy": 2, "individualism": 1, "minimalism": -2, "order": -2 } },
  { "id": 85, "group": "values", "cluster": "function-first", "text": "How well something works matters more to me than how it looks.", "dimensions": { "realism": 3, "ornament": -2, "refinement": -2, "order": 1 } },
  { "id": 86, "group": "home", "cluster": "remote-cabin", "text": "I dream of a small place of my own, far from any other house.", "dimensions": { "solitude": 3, "rural": 2, "nature": 2, "comfort": 2, "social": -2 } },
  { "id": 87, "group": "home", "cluster": "airy-light", "text": "Bright, airy rooms with natural materials and few colours are my ideal.", "dimensions": { "minimalism": 3, "order": 2, "organic": 2, "optimism": 1, "refinement": 2, "maximalism": -2, "darkness": -2 } },
  { "id": 88, "group": "people", "cluster": "crowd-energy", "text": "Being among a lot of people gives me energy.", "dimensions": { "social": 3, "urban": 2, "community": 1, "solitude": -3 } },
  { "id": 89, "group": "people", "cluster": "small-evenings", "text": "My best evenings are small ones, with few people and long conversations.", "dimensions": { "community": 2, "intellect": 2, "comfort": 2, "social": -1, "refinement": 1 } },
  { "id": 90, "group": "people", "cluster": "alone-activities", "text": "I'm happy doing things alone that most people prefer to do together.", "dimensions": { "solitude": 3, "individualism": 3, "social": -2 } },
  { "id": 91, "group": "tradition", "cluster": "belonging-group", "text": "Belonging to a group with shared interests means a lot to me.", "dimensions": { "community": 3, "social": 2, "tradition": 1, "individualism": -1 } },
  { "id": 92, "group": "values", "cluster": "stand-out", "text": "I'd rather stand out than fit in.", "dimensions": { "individualism": 3, "chaos": 1, "whimsy": 1, "tradition": -2, "community": -1 } },
  { "id": 93, "group": "temperament", "cluster": "same-days", "text": "I'm at my best when my days resemble one another.", "dimensions": { "order": 3, "comfort": 2, "tradition": 2, "chaos": -2, "adventure": -2 } },
  { "id": 94, "group": "city-country", "cluster": "alone-among-people", "text": "I like places where I can be alone among people - cafes, trains, libraries.", "dimensions": { "urban": 2, "solitude": 2, "melancholy": 1, "intellect": 1 } },
  { "id": 95, "group": "tradition", "cluster": "neighbourhood", "text": "Helping neighbours and knowing people locally matters to me.", "dimensions": { "community": 3, "tradition": 2, "rural": 1, "individualism": -1 } },
  { "id": 96, "group": "people", "cluster": "leave-parties", "text": "I get tired of gatherings quickly and want to go home.", "dimensions": { "solitude": 3, "social": -3, "comfort": 1 } },
  { "id": 97, "group": "people", "cluster": "parties-noise", "text": "Parties, crowds and noise are part of what I like best about life.", "dimensions": { "social": 3, "chaos": 2, "urban": 2, "maximalism": 1, "solitude": -3 } },
  { "id": 98, "group": "people", "cluster": "few-confidants", "text": "I'd rather share my interests with a few people than with everyone.", "dimensions": { "solitude": 2, "individualism": 2, "intellect": 1, "social": -1 } },
  { "id": 99, "group": "tradition", "cluster": "role-in-community", "text": "Having a role in a community gives life meaning.", "dimensions": { "community": 3, "tradition": 2, "social": 2, "individualism": -2 } },
  { "id": 100, "group": "people", "cluster": "self-determination", "text": "I'd rather decide for myself, even when it makes things harder.", "dimensions": { "individualism": 3, "adventure": 1, "chaos": 1, "community": -2 } },
  { "id": 101, "group": "tradition", "cluster": "being-cared-for", "text": "I quite like being looked after by other people.", "dimensions": { "community": 2, "comfort": 2, "social": 1, "individualism": -2 } },
  { "id": 102, "group": "people", "cluster": "learned-solitude", "text": "Solitude is something I've learned to enjoy.", "dimensions": { "solitude": 3, "melancholy": 2, "individualism": 2, "social": -2 } },
  { "id": 103, "group": "unexplained", "cluster": "unexplained-stories", "text": "I like stories best when they're never fully explained.", "dimensions": { "mystery": 3, "fantasy": 1, "realism": -2, "order": -1 } },
  { "id": 104, "group": "tradition", "cluster": "superstition", "text": "Superstitions and old customs are charming, even though I don't believe in them.", "dimensions": { "mystery": 2, "tradition": 2, "fantasy": 2, "whimsy": 1, "history": 1 } },
  { "id": 105, "group": "imagination", "cluster": "other-worlds", "text": "I think a lot about what other worlds might look like.", "dimensions": { "fantasy": 3, "whimsy": 1, "mystery": 2, "realism": -2 } },
  { "id": 106, "group": "unexplained", "cluster": "explanations", "text": "I want to know how things actually connect, not what they might mean.", "dimensions": { "realism": 3, "intellect": 2, "fantasy": -2, "mystery": -2 } },
  { "id": 107, "group": "unexplained", "cluster": "scary-comfort", "text": "Frightening stories give me a comfortable feeling, not an uneasy one.", "dimensions": { "darkness": 3, "mystery": 2, "comfort": 1, "optimism": -1 } },
  { "id": 108, "group": "unexplained", "cluster": "unexplained-world", "text": "I think there are things in the world we haven't explained yet.", "dimensions": { "mystery": 3, "fantasy": 2, "realism": -1 } },
  { "id": 109, "group": "imagination", "cluster": "dreams-memory", "text": "Dreams and half-forgotten memories shape how I see the world.", "dimensions": { "fantasy": 2, "nostalgia": 2, "mystery": 2, "melancholy": 1, "realism": -1 } },
  { "id": 110, "group": "imagination", "cluster": "odd-humour", "text": "I like humour that's strange and unpredictable.", "dimensions": { "whimsy": 3, "chaos": 2, "individualism": 1, "refinement": -1 } },
  { "id": 111, "group": "unexplained", "cluster": "wrong-places", "text": "Places that feel slightly wrong, without my being able to say why, fascinate me.", "dimensions": { "mystery": 3, "darkness": 2, "chaos": 1, "fantasy": 1, "realism": -1 } },
  { "id": 112, "group": "imagination", "cluster": "collecting", "text": "I collect small things other people would throw away.", "dimensions": { "whimsy": 2, "maximalism": 2, "nostalgia": 2, "craft": 1, "minimalism": -2 } },
  { "id": 113, "group": "tradition", "cluster": "ritual-calm", "text": "Symbols, rituals and repetition put me at ease.", "dimensions": { "tradition": 2, "mystery": 2, "order": 2, "refinement": 1 } },
  { "id": 114, "group": "unexplained", "cluster": "nonfiction", "text": "I'd rather read a book of facts than a novel.", "dimensions": { "intellect": 2, "realism": 3, "fantasy": -2 } },
  { "id": 115, "group": "weather", "cluster": "moonlight", "text": "Moonlight, shadows and things only half visible are beautiful.", "dimensions": { "darkness": 2, "mystery": 3, "melancholy": 1, "fantasy": 1 } },
  { "id": 116, "group": "imagination", "cluster": "childlike", "text": "I think it's healthy to keep a bit of childishness.", "dimensions": { "whimsy": 3, "optimism": 2, "fantasy": 2, "refinement": -1 } },
  { "id": 117, "group": "temperament", "cluster": "observer", "text": "I sometimes feel like a spectator to my own era.", "dimensions": { "melancholy": 3, "solitude": 2, "mystery": 1, "nostalgia": 1 } },
  { "id": 118, "group": "order", "cluster": "planning", "text": "I happily plan holidays down to the detail.", "dimensions": { "order": 3, "comfort": 1, "chaos": -2, "adventure": -1 } },
  { "id": 119, "group": "order", "cluster": "unplanned-best", "text": "The best things in my life happened without planning.", "dimensions": { "chaos": 3, "adventure": 2, "optimism": 1, "order": -2 } },
  { "id": 120, "group": "order", "cluster": "mess-unease", "text": "Mess around me makes me uneasy.", "dimensions": { "order": 3, "minimalism": 2, "chaos": -3, "maximalism": -1 } },
  { "id": 121, "group": "order", "cluster": "creative-mess", "text": "I work best when there's a bit of disorder around me.", "dimensions": { "chaos": 3, "individualism": 1, "craft": 1, "order": -2, "maximalism": 1 } },
  { "id": 122, "group": "order", "cluster": "rules", "text": "Rules exist to be followed, not interpreted.", "dimensions": { "order": 3, "tradition": 2, "individualism": -2, "chaos": -2 } },
  { "id": 123, "group": "order", "cluster": "unfinished", "text": "I like things that are a little unfinished.", "dimensions": { "chaos": 2, "craft": 2, "organic": 2, "realism": 1, "refinement": -2 } },
  { "id": 124, "group": "order", "cluster": "routines", "text": "I keep routines I'm reluctant to break.", "dimensions": { "order": 3, "tradition": 2, "comfort": 2, "chaos": -2, "adventure": -1 } },
  { "id": 125, "group": "travel", "cluster": "light-packing", "text": "I pack light and will leave at short notice.", "dimensions": { "adventure": 3, "chaos": 2, "minimalism": 2, "comfort": -1, "order": -1 } },
  { "id": 126, "group": "craft-tools", "cluster": "perfect-craft", "text": "Perfectly executed craftsmanship impresses me more than bold ideas.", "dimensions": { "craft": 2, "refinement": 3, "order": 2, "chaos": -2 } },
  { "id": 127, "group": "order", "cluster": "everything-its-place", "text": "I like things to have a clear place and a clear name.", "dimensions": { "order": 3, "intellect": 1, "minimalism": 1, "chaos": -2 } },
  { "id": 128, "group": "travel", "cluster": "travel-unpredictable", "text": "Unpredictability is the best part of travelling.", "dimensions": { "adventure": 3, "chaos": 2, "order": -2, "comfort": -1 } },
  { "id": 129, "group": "order", "cluster": "one-thing-at-a-time", "text": "I'd rather finish one thing before starting the next.", "dimensions": { "order": 3, "refinement": 1, "chaos": -2 } },
  { "id": 130, "group": "style", "cluster": "muted-colours", "text": "I'm drawn to muted, earthy colours rather than strong, bright ones.", "dimensions": { "organic": 2, "minimalism": 1, "melancholy": 1, "refinement": 1, "maximalism": -1 } },
  { "id": 131, "group": "style", "cluster": "clothes-identity", "text": "My clothes should say something about who I am, not just cover me.", "dimensions": { "individualism": 3, "ornament": 2, "refinement": 1, "realism": -1 } },
  { "id": 132, "group": "style", "cluster": "anonymous-clothes", "text": "I prefer clothes that are anonymous and easy to wear.", "dimensions": { "minimalism": 3, "realism": 2, "comfort": 2, "individualism": -2, "ornament": -2 } },
  { "id": 133, "group": "style", "cluster": "lo-fi-sound", "text": "Music with noise, hiss and rough edges is warmer than a perfectly clean production.", "dimensions": { "craft": 2, "nostalgia": 2, "retro": 2, "chaos": 2, "organic": 1 } },
  { "id": 134, "group": "weather", "cluster": "contrast", "text": "I like strong contrast: very dark against very light.", "dimensions": { "darkness": 3, "refinement": 1, "mystery": 2, "order": 1 } },
  { "id": 135, "group": "style", "cluster": "chrome-gloss", "text": "Gloss, chrome and mirrored surfaces appeal to me.", "dimensions": { "futurism": 2, "refinement": 2, "digital": 2, "modernity": 2, "organic": -2 } },
  { "id": 136, "group": "style", "cluster": "pattern-layers", "text": "I like patterns, textiles and layer upon layer.", "dimensions": { "maximalism": 3, "ornament": 3, "comfort": 2, "craft": 1, "minimalism": -3 } },
  { "id": 137, "group": "weather", "cluster": "low-light", "text": "Candles and low lamps beat an overhead light.", "dimensions": { "comfort": 3, "darkness": 2, "melancholy": 1, "mystery": 1 } },
  { "id": 138, "group": "temperament", "cluster": "beauty-over-provocation", "text": "Art that's beautiful moves me more than art that's provocative.", "dimensions": { "refinement": 3, "ornament": 2, "tradition": 2, "chaos": -2 } },
  { "id": 139, "group": "style", "cluster": "hardwearing-clothes", "text": "Clothes should look like they can take hard wear.", "dimensions": { "craft": 2, "adventure": 2, "realism": 2, "industrial": 1, "refinement": -2 } },
  { "id": 140, "group": "style", "cluster": "artificial-shine", "text": "Colours that glitter, shine and look a bit artificial are fun.", "dimensions": { "whimsy": 3, "digital": 2, "maximalism": 2, "futurism": 1, "organic": -2 } },
  { "id": 141, "group": "weather", "cluster": "light-before-furniture", "text": "I notice the light in a room before I notice the furniture.", "dimensions": { "architecture": 2, "refinement": 2, "mystery": 1, "melancholy": 1 } },
  { "id": 142, "group": "temperament", "cluster": "transience", "text": "I often think about how everything I see will one day be gone.", "dimensions": { "melancholy": 3, "darkness": 2, "history": 2, "mystery": 1 } },
  { "id": 143, "group": "temperament", "cluster": "enthusiasm", "text": "I get enthusiastic easily.", "dimensions": { "optimism": 3, "whimsy": 2, "social": 1, "melancholy": -2 } },
  { "id": 144, "group": "values", "cluster": "deep-learning", "text": "Learning something thoroughly is one of the greatest pleasures I know.", "dimensions": { "intellect": 3, "order": 1, "refinement": 1 } },
  { "id": 145, "group": "temperament", "cluster": "seriousness", "text": "I take myself fairly seriously.", "dimensions": { "refinement": 2, "intellect": 2, "order": 1, "whimsy": -3 } },
  { "id": 146, "group": "travel", "cluster": "comfort-over-thrill", "text": "I'd rather live comfortably than excitingly.", "dimensions": { "comfort": 3, "order": 2, "adventure": -3 } },
  { "id": 147, "group": "values", "cluster": "authenticity", "text": "Being genuine matters more than being pretty.", "dimensions": { "realism": 3, "individualism": 2, "refinement": -2, "ornament": -2 } },
  { "id": 148, "group": "past", "cluster": "sentimental", "text": "I'm moved by things other people find sentimental.", "dimensions": { "nostalgia": 3, "melancholy": 2, "comfort": 1, "whimsy": 1 } },
  { "id": 149, "group": "travel", "cluster": "striving", "text": "I like having something to strive towards, even when it's exhausting.", "dimensions": { "adventure": 2, "individualism": 2, "intellect": 1, "comfort": -2 } },
  { "id": 150, "group": "temperament", "cluster": "world-friendly", "text": "The world is fundamentally a friendly place.", "dimensions": { "optimism": 3, "community": 2, "darkness": -2, "melancholy": -2 } },
  { "id": 151, "group": "values", "cluster": "formality", "text": "I prefer people who are formal and polite to people who are blunt and rough.", "dimensions": { "refinement": 3, "tradition": 2, "order": 2, "chaos": -2 } },
  { "id": 152, "group": "temperament", "cluster": "sad-and-beautiful", "text": "I'm drawn to things that are sad and beautiful at the same time.", "dimensions": { "melancholy": 3, "darkness": 2, "refinement": 2, "mystery": 1 } },
  { "id": 153, "group": "craft-tools", "cluster": "hands-rest", "text": "I'd rather work with my hands when I want to unwind.", "dimensions": { "craft": 3, "organic": 1, "comfort": 1, "digital": -2 } },
  { "id": 154, "group": "screens", "cluster": "no-diy", "text": "I have neither the time nor the interest to make things myself.", "dimensions": { "craft": -3, "modernity": 1, "comfort": 1, "individualism": -1 } },
  { "id": 155, "group": "values", "cluster": "gut-feeling", "text": "I trust my gut more than thorough research.", "dimensions": { "intellect": -3, "whimsy": 1, "fantasy": 1, "chaos": 1 } },
  { "id": 156, "group": "buildings", "cluster": "rooms-invisible", "text": "I rarely notice how a room has been designed.", "dimensions": { "architecture": -3, "ornament": -1, "refinement": -1, "realism": 1 } },
  { "id": 157, "group": "weather", "cluster": "fog-vs-clear", "text": "Fog does more for a landscape than clear weather does.", "dimensions": { "mystery": 2, "melancholy": 2, "nature": 1, "darkness": 1, "optimism": -1 } },
  { "id": 158, "group": "weather", "cluster": "sunshine-mood", "text": "My mood lifts noticeably when the sun is out.", "dimensions": { "optimism": 3, "social": 1, "darkness": -2, "melancholy": -2 } },
  { "id": 159, "group": "city-country", "cluster": "living-close", "text": "Living close to other people is more practical than tiring.", "dimensions": { "urban": 2, "community": 2, "social": 2, "solitude": -2, "rural": -1 } },
  { "id": 160, "group": "city-country", "cluster": "worn-city", "text": "A city is best when it's a little worn at the edges.", "dimensions": { "urban": 2, "history": 2, "chaos": 2, "modernity": -2, "realism": 1 } },
  { "id": 161, "group": "city-country", "cluster": "walking-distance", "text": "I want a shop, a cafe and a stop within walking distance.", "dimensions": { "urban": 3, "modernity": 1, "community": 1, "rural": -2, "solitude": -1 } },
  { "id": 162, "group": "screens", "cluster": "plain-software", "text": "I like software and websites that look as simple as they are.", "dimensions": { "minimalism": 2, "order": 2, "modernity": 1, "maximalism": -2, "ornament": -2 } },
  { "id": 163, "group": "future", "cluster": "space", "text": "We should spend more money exploring space.", "dimensions": { "futurism": 3, "adventure": 2, "optimism": 2, "technology": 2 } },
  { "id": 164, "group": "future", "cluster": "more-of-same", "text": "I think the coming decades will resemble the last ones more than people expect.", "dimensions": { "futurism": -2, "tradition": 2, "realism": 2, "modernity": -1 } },
  { "id": 165, "group": "future", "cluster": "new-materials", "text": "New materials and new methods are more exciting than old ones.", "dimensions": { "futurism": 2, "modernity": 3, "technology": 2, "tradition": -2, "craft": -1 } },
  { "id": 166, "group": "people", "cluster": "unknown-number", "text": "I'll happily answer the phone when an unknown number calls.", "dimensions": { "social": 2, "community": 1, "solitude": -2, "adventure": 1 } },
  { "id": 167, "group": "unexplained", "cluster": "sacred-places", "text": "There are places where you should behave well, even when nobody is watching.", "dimensions": { "mystery": 2, "tradition": 2, "darkness": 1, "realism": -1 } },
  { "id": 168, "group": "imagination", "cluster": "strangers-stories", "text": "I easily invent stories about people I see on the street.", "dimensions": { "fantasy": 3, "whimsy": 2, "mystery": 1, "realism": -1 } },
  { "id": 169, "group": "imagination", "cluster": "childhood-things", "text": "I still have things from childhood I won't part with.", "dimensions": { "nostalgia": 3, "whimsy": 2, "comfort": 1, "maximalism": 1 } },
  { "id": 170, "group": "imagination", "cluster": "invented-art", "text": "I prefer art that's plainly invented to art that depicts reality.", "dimensions": { "fantasy": 3, "ornament": 1, "realism": -3 } },
  { "id": 171, "group": "imagination", "cluster": "fun-is-enough", "text": "Having fun is a good enough reason on its own.", "dimensions": { "whimsy": 3, "optimism": 2, "refinement": -2, "intellect": -1 } },
  { "id": 172, "group": "imagination", "cluster": "impatient-with-fantasy", "text": "I lose patience quickly with things that are pure fantasy.", "dimensions": { "fantasy": -3, "realism": 3, "whimsy": -2 } },
  { "id": 173, "group": "travel", "cluster": "one-place-deep", "text": "I'd rather see one place thoroughly than five places quickly.", "dimensions": { "intellect": 2, "order": 1, "refinement": 1, "comfort": 1, "adventure": -1 } },
  { "id": 174, "group": "travel", "cluster": "getting-lost", "text": "Getting lost is part of the experience.", "dimensions": { "adventure": 3, "chaos": 2, "mystery": 1, "order": -2 } },
  { "id": 175, "group": "travel", "cluster": "bad-at-it", "text": "I want to try something I know I'm bad at.", "dimensions": { "adventure": 2, "individualism": 2, "whimsy": 1, "comfort": -2 } },
  { "id": 176, "group": "travel", "cluster": "same-places", "text": "I prefer to travel to places I've been before.", "dimensions": { "comfort": 2, "tradition": 2, "order": 2, "adventure": -3 } },
  { "id": 177, "group": "temperament", "cluster": "noticing-endings", "text": "I notice beautiful things ending while they're still happening.", "dimensions": { "melancholy": 3, "refinement": 2, "mystery": 1, "nostalgia": 1 } },
  { "id": 178, "group": "values", "cluster": "skilled-not-interesting", "text": "I'd rather be skilled than interesting.", "dimensions": { "refinement": 2, "intellect": 2, "order": 1, "individualism": -2, "whimsy": -2 } },
  { "id": 179, "group": "values", "cluster": "own-taste", "text": "I care little what people think of my taste.", "dimensions": { "individualism": 3, "chaos": 1, "refinement": -1, "community": -2 } },
  { "id": 180, "group": "values", "cluster": "done-properly", "text": "Doing a job properly matters more than doing it fast.", "dimensions": { "craft": 2, "refinement": 2, "order": 2, "intellect": 1 } }
]
