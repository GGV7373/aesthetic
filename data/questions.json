[
  { "id": 1, "category": "nature", "cluster": "wilderness", "text": "Jeg trives best på steder der jeg ikke kan høre trafikk.", "dimensions": { "nature": 2, "solitude": 2, "rural": 1, "urban": -2 } },
  { "id": 2, "category": "nature", "cluster": "weather", "text": "Regn og lavt skydekke gjør en dag bedre, ikke verre.", "dimensions": { "nature": 1, "melancholy": 2, "mystery": 1, "optimism": -1, "darkness": 1 } },
  { "id": 3, "category": "nature", "cluster": "plants-indoors", "text": "Et rom uten noe levende i seg føles uferdig for meg.", "dimensions": { "nature": 2, "organic": 2, "comfort": 1, "minimalism": -1 } },
  { "id": 4, "category": "nature", "cluster": "water", "text": "Jeg dras mot kyst, elver og innsjøer mer enn mot åpne sletter.", "dimensions": { "nature": 2, "adventure": 1, "mystery": 1, "melancholy": 1 } },
  { "id": 5, "category": "nature", "cluster": "nature-reclaims", "text": "Jeg liker omgivelser hvor naturen er tydelig til stede, selv når stedet egentlig er laget for mennesker.", "dimensions": { "nature": 2, "organic": 2, "chaos": 1, "order": -1, "architecture": 1 } },
  { "id": 6, "category": "nature", "cluster": "controlled-nature", "text": "Klippede hekker og symmetriske hager er finere enn en hage som får vokse litt fritt.", "dimensions": { "order": 2, "ornament": 1, "tradition": 1, "refinement": 1, "chaos": -2, "organic": -1 } },
  { "id": 7, "category": "nature", "cluster": "seasons-dark", "text": "Sen høst og tidlig vinter er årstidene jeg liker best.", "dimensions": { "melancholy": 2, "nature": 1, "darkness": 1, "solitude": 1, "optimism": -1 } },
  { "id": 8, "category": "nature", "cluster": "animals", "text": "Å vite at det finnes dyr i nærheten som jeg ikke ser, gjør et sted mer interessant.", "dimensions": { "nature": 2, "mystery": 2, "fantasy": 1, "organic": 1 } },
  { "id": 9, "category": "nature", "cluster": "outdoor-comfort", "text": "Jeg vil helst nyte naturen gjennom et vindu, med varme i rommet.", "dimensions": { "comfort": 2, "nature": 1, "solitude": 1, "adventure": -2 } },
  { "id": 10, "category": "nature", "cluster": "wilderness", "text": "Uberørt villmark tiltrekker meg mer enn velstelte parker.", "dimensions": { "nature": 2, "adventure": 2, "chaos": 1, "solitude": 1, "order": -2 } },
  { "id": 11, "category": "nature", "cluster": "growing", "text": "Å dyrke noe selv gir meg mer enn å kjøpe det ferdig.", "dimensions": { "craft": 2, "nature": 2, "tradition": 1, "community": 1, "organic": 1 } },
  { "id": 12, "category": "nature", "cluster": "city-energy", "text": "Jeg får mer energi av en storby enn av en skogstur.", "dimensions": { "urban": 3, "social": 2, "nature": -2, "solitude": -1, "modernity": 1 } },
  { "id": 13, "category": "nature", "cluster": "materials-patina", "text": "Materialer som slites pent — tre, lær, stein — er finere enn materialer som holder seg helt nye.", "dimensions": { "craft": 2, "organic": 2, "history": 1, "nostalgia": 1, "modernity": -2 } },
  { "id": 14, "category": "nature", "cluster": "light-grey", "text": "Dempet, grått dagslys passer meg bedre enn sterk sol.", "dimensions": { "melancholy": 2, "darkness": 1, "mystery": 1, "optimism": -2 } },
  { "id": 15, "category": "nature", "cluster": "hidden-landscape", "text": "Landskap som skjuler noe er mer interessante enn landskap som viser alt på én gang.", "dimensions": { "mystery": 3, "nature": 1, "fantasy": 1, "realism": -1 } },
  { "id": 16, "category": "nature", "cluster": "long-walk", "text": "Jeg vil heller gå langt alene enn kort sammen med mange.", "dimensions": { "solitude": 3, "adventure": 2, "social": -2, "individualism": 1 } },
  { "id": 17, "category": "nature", "cluster": "decay", "text": "Mose, lav og forfall på bygninger er vakkert, ikke stygt.", "dimensions": { "organic": 2, "history": 2, "chaos": 1, "mystery": 1, "modernity": -2, "order": -1 } },
  { "id": 18, "category": "nature", "cluster": "sea-fear", "text": "Havet er mer skremmende enn tiltrekkende for meg.", "dimensions": { "adventure": -2, "mystery": -1, "comfort": 1, "nature": -1 } },
  { "id": 19, "category": "nature", "cluster": "indoor-life", "text": "Jeg kunne fint bodd et sted uten hage eller balkong.", "dimensions": { "nature": -2, "urban": 1, "minimalism": 1, "organic": -1 } },
  { "id": 20, "category": "nature", "cluster": "fire", "text": "Åpen ild — bål, peis, stearinlys — gjør nesten hvilket som helst sted bedre.", "dimensions": { "comfort": 2, "tradition": 1, "nature": 1, "nostalgia": 1, "darkness": 1 } },
  { "id": 21, "category": "nature", "cluster": "shelter-storm", "text": "Å være inne i storm, tørr og trygg, er en av de beste følelsene jeg vet om.", "dimensions": { "comfort": 3, "solitude": 2, "melancholy": 1, "nature": 1 } },
  { "id": 22, "category": "nature", "cluster": "uncomfortable-places", "text": "Steder som er litt ubehagelige å oppholde seg på, kan likevel være verdt å oppsøke.", "dimensions": { "adventure": 2, "darkness": 1, "mystery": 1, "comfort": -2, "realism": 1 } },
  { "id": 23, "category": "nature", "cluster": "village", "text": "Jeg kunne trives i en liten bygd der alle vet hvem alle er.", "dimensions": { "rural": 3, "community": 2, "tradition": 1, "urban": -2, "individualism": -1 } },
  { "id": 24, "category": "nature", "cluster": "city-parks", "text": "Parkene er det beste ved en by.", "dimensions": { "nature": 2, "urban": 1, "organic": 1, "comfort": 1 } },
  { "id": 25, "category": "nature", "cluster": "summer-light", "text": "Lange, lyse sommerkvelder er min favorittstemning.", "dimensions": { "optimism": 2, "social": 1, "nature": 1, "melancholy": -1, "darkness": -2 } },
  { "id": 26, "category": "nature", "cluster": "food-origin", "text": "Mat smaker bedre når jeg vet hvor den kommer fra.", "dimensions": { "tradition": 1, "craft": 2, "nature": 1, "community": 1, "rural": 1 } },
  { "id": 27, "category": "nature", "cluster": "silence", "text": "Stillhet er noe jeg oppsøker, ikke noe jeg må fylle.", "dimensions": { "solitude": 3, "minimalism": 1, "social": -1, "melancholy": 1 } },

  { "id": 28, "category": "history", "cluster": "old-places", "text": "Jeg føler meg mer tiltrukket av steder som har en tydelig forbindelse til fortiden enn av steder som er nye og perfekte.", "dimensions": { "history": 3, "nostalgia": 2, "modernity": -2, "architecture": 1 } },
  { "id": 29, "category": "history", "cluster": "secondhand", "text": "Bruktbutikker og loppemarkeder er mer spennende enn nye butikker.", "dimensions": { "nostalgia": 2, "history": 2, "craft": 1, "maximalism": 1, "modernity": -2 } },
  { "id": 30, "category": "history", "cluster": "inherited", "text": "Ting jeg har arvet betyr mer for meg enn ting jeg har kjøpt.", "dimensions": { "tradition": 2, "history": 2, "nostalgia": 2, "community": 1, "individualism": -1 } },
  { "id": 31, "category": "history", "cluster": "no-nostalgia", "text": "Jeg savner sjelden hvordan ting var før.", "dimensions": { "nostalgia": -3, "modernity": 2, "futurism": 1, "tradition": -1 } },
  { "id": 32, "category": "history", "cluster": "old-photos", "text": "Gamle fotografier av folk jeg ikke kjenner kan gjøre meg rørt.", "dimensions": { "nostalgia": 3, "melancholy": 2, "history": 2, "mystery": 1 } },
  { "id": 33, "category": "history", "cluster": "rituals-tradition", "text": "Tradisjoner er verdt å holde i live selv når ingen husker hvorfor de oppsto.", "dimensions": { "tradition": 3, "history": 1, "community": 1, "mystery": 1, "modernity": -1 } },
  { "id": 34, "category": "history", "cluster": "old-media", "text": "Jeg liker best filmer og musikk som ble laget før jeg ble født.", "dimensions": { "retro": 3, "nostalgia": 2, "history": 1, "modernity": -1 } },
  { "id": 35, "category": "history", "cluster": "new-looks-new", "text": "Ny teknologi burde se ny ut, ikke etterligne noe gammelt.", "dimensions": { "modernity": 2, "futurism": 2, "retro": -2, "nostalgia": -1, "minimalism": 1 } },
  { "id": 36, "category": "history", "cluster": "old-house", "text": "Et hus som har historie er verdt de skjeve gulvene.", "dimensions": { "history": 3, "tradition": 1, "craft": 1, "comfort": -1, "order": -1, "architecture": 1 } },
  { "id": 37, "category": "history", "cluster": "future-different", "text": "Jeg liker tanken på at framtiden blir helt annerledes enn nå.", "dimensions": { "futurism": 3, "optimism": 1, "modernity": 2, "tradition": -2 } },
  { "id": 38, "category": "history", "cluster": "past-meaning", "text": "Måten folk levde for hundre år siden virker mer meningsfull enn måten vi lever nå.", "dimensions": { "tradition": 2, "history": 2, "nostalgia": 2, "melancholy": 1, "modernity": -2, "futurism": -1 } },
  { "id": 39, "category": "history", "cluster": "childhood-tech", "text": "Jeg blir lett nostalgisk over teknologi jeg brukte som barn.", "dimensions": { "nostalgia": 3, "retro": 2, "digital": 2, "technology": 1 } },
  { "id": 40, "category": "history", "cluster": "museums", "text": "Museer er blant de beste stedene jeg vet om.", "dimensions": { "history": 3, "intellect": 2, "order": 1, "refinement": 1 } },
  { "id": 41, "category": "history", "cluster": "true-story", "text": "Jeg foretrekker en historie som er sann framfor en som er vakker.", "dimensions": { "realism": 3, "intellect": 1, "fantasy": -2, "ornament": -1 } },
  { "id": 42, "category": "history", "cluster": "archives", "text": "Gamle kart, brev og dagbøker fascinerer meg.", "dimensions": { "history": 3, "mystery": 2, "intellect": 2, "nostalgia": 1 } },
  { "id": 43, "category": "history", "cluster": "new-apartment", "text": "Jeg vil heller bo i en nybygd leilighet enn i en gammel bygård.", "dimensions": { "modernity": 3, "order": 2, "comfort": 1, "history": -2, "nostalgia": -1 } },
  { "id": 44, "category": "history", "cluster": "disappearing", "text": "Det finnes noe trist, men vakkert, ved ting som er i ferd med å forsvinne.", "dimensions": { "melancholy": 3, "history": 2, "nostalgia": 2, "darkness": 1 } },
  { "id": 45, "category": "history", "cluster": "paper", "text": "Håndskrift, brev og fysiske bøker har en verdi som skjermer ikke kan erstatte.", "dimensions": { "craft": 2, "tradition": 2, "nostalgia": 2, "digital": -2, "intellect": 1 } },
  { "id": 46, "category": "history", "cluster": "layered-time", "text": "Jeg liker steder der flere tidsepoker er synlige samtidig.", "dimensions": { "history": 2, "maximalism": 2, "chaos": 1, "mystery": 1, "architecture": 1 } },
  { "id": 47, "category": "history", "cluster": "not-keeping", "text": "Jeg har lite behov for å bevare ting bare fordi de er gamle.", "dimensions": { "history": -2, "nostalgia": -2, "modernity": 2, "minimalism": 2 } },
  { "id": 48, "category": "history", "cluster": "ancestry", "text": "Fortellinger om folk som levde før meg gir meg en følelse av tilhørighet.", "dimensions": { "history": 2, "community": 2, "tradition": 2, "nostalgia": 1 } },

  { "id": 49, "category": "tech", "cluster": "tech-wonder", "text": "Jeg blir oppriktig begeistret når jeg ser noe teknologisk som virker som magi.", "dimensions": { "technology": 3, "futurism": 2, "optimism": 2, "fantasy": 1 } },
  { "id": 50, "category": "tech", "cluster": "old-internet", "text": "Internett var bedre da det var rotete og amatørmessig.", "dimensions": { "digital": 2, "nostalgia": 3, "retro": 2, "chaos": 2, "order": -2, "individualism": 1 } },
  { "id": 51, "category": "tech", "cluster": "invisible-tech", "text": "Jeg vil helst at teknologi skal være usynlig i hverdagen min.", "dimensions": { "minimalism": 2, "order": 1, "nature": 1, "technology": -1, "maximalism": -1 } },
  { "id": 52, "category": "tech", "cluster": "visible-mechanism", "text": "Jeg liker maskiner der jeg kan se hvordan de fungerer.", "dimensions": { "craft": 3, "industrial": 2, "technology": 2, "ornament": 1, "intellect": 1 } },
  { "id": 53, "category": "tech", "cluster": "future-fear", "text": "Framtiden virker mer skremmende enn spennende.", "dimensions": { "futurism": -2, "melancholy": 2, "darkness": 2, "optimism": -3 } },
  { "id": 54, "category": "tech", "cluster": "tech-nature-union", "text": "Jeg tror teknologi og natur kan gå opp i en høyere enhet.", "dimensions": { "technology": 2, "nature": 2, "organic": 2, "futurism": 2, "optimism": 2 } },
  { "id": 55, "category": "tech", "cluster": "screens-night", "text": "Skjermer og lys om natten gir meg en trygg, hjemmekjær følelse.", "dimensions": { "digital": 3, "urban": 1, "comfort": 2, "solitude": 1, "darkness": 1 } },
  { "id": 56, "category": "tech", "cluster": "hand-tools", "text": "Jeg foretrekker verktøy av metall og tre framfor verktøy med app.", "dimensions": { "craft": 3, "tradition": 2, "digital": -2, "technology": -1, "realism": 1 } },
  { "id": 57, "category": "tech", "cluster": "machines-beauty", "text": "Store maskiner, kraner og fabrikker har en egen skjønnhet.", "dimensions": { "industrial": 3, "urban": 1, "realism": 1, "adventure": 1, "architecture": 1 } },
  { "id": 58, "category": "tech", "cluster": "old-computers", "text": "Jeg liker estetikken i gamle datamaskiner og eldre grensesnitt.", "dimensions": { "retro": 3, "digital": 3, "nostalgia": 2, "technology": 1 } },
  { "id": 59, "category": "tech", "cluster": "function-over-form", "text": "Jeg vil heller ha en bil som er pålitelig enn en som er vakker.", "dimensions": { "realism": 2, "comfort": 1, "ornament": -2, "refinement": -1 } },
  { "id": 60, "category": "tech", "cluster": "progress", "text": "Verden blir gradvis bedre, tross alt.", "dimensions": { "optimism": 3, "futurism": 2, "modernity": 1, "melancholy": -2, "darkness": -1 } },
  { "id": 61, "category": "tech", "cluster": "bright-scifi", "text": "Jeg liker science fiction som forestiller seg en lys og ren framtid mer enn en mørk og ødelagt en.", "dimensions": { "futurism": 2, "optimism": 3, "minimalism": 1, "order": 1, "darkness": -2 } },
  { "id": 62, "category": "tech", "cluster": "unavailable", "text": "Jeg savner en tid da man ikke var tilgjengelig hele tiden.", "dimensions": { "nostalgia": 2, "solitude": 2, "digital": -2, "social": -1, "tradition": 1 } },
  { "id": 63, "category": "tech", "cluster": "neon-night", "text": "Kunstig lys, refleksjoner og våt asfalt om natten er vakkert.", "dimensions": { "urban": 3, "digital": 2, "darkness": 2, "mystery": 2, "nature": -1 } },
  { "id": 64, "category": "tech", "cluster": "how-things-work", "text": "Jeg leser gjerne om hvordan ting er bygget og hvorfor de fungerer.", "dimensions": { "intellect": 3, "technology": 2, "craft": 1, "realism": 1 } },
  { "id": 65, "category": "tech", "cluster": "simple-solutions", "text": "Jeg har mest tro på løsninger som er enkle og gammeldagse.", "dimensions": { "tradition": 3, "craft": 2, "realism": 2, "futurism": -2, "technology": -1 } },
  { "id": 66, "category": "tech", "cluster": "modding", "text": "Å bygge om, reparere og modifisere ting selv er noe jeg liker.", "dimensions": { "craft": 3, "individualism": 2, "industrial": 1, "chaos": 1, "technology": 1 } },
  { "id": 67, "category": "tech", "cluster": "built-to-last", "text": "Jeg synes det er noe vakkert ved ting som er laget for å vare i hundre år.", "dimensions": { "craft": 2, "tradition": 2, "order": 1, "refinement": 1, "history": 1 } },
  { "id": 68, "category": "tech", "cluster": "digital-space", "text": "Et digitalt rom kan føles like ekte som et fysisk sted.", "dimensions": { "digital": 3, "fantasy": 2, "technology": 2, "realism": -1 } },
  { "id": 69, "category": "tech", "cluster": "update-fatigue", "text": "Jeg blir sliten av å måtte forholde meg til nye plattformer og oppdateringer.", "dimensions": { "digital": -2, "modernity": -2, "tradition": 2, "comfort": 1, "futurism": -1 } },

  { "id": 70, "category": "architecture", "cluster": "concrete", "text": "Rå betong kan være like vakkert som marmor.", "dimensions": { "industrial": 3, "minimalism": 2, "realism": 2, "architecture": 2, "ornament": -2 } },
  { "id": 71, "category": "architecture", "cluster": "detail-decoration", "text": "Detaljer og utsmykning gjør en bygning bedre, ikke rotete.", "dimensions": { "ornament": 3, "maximalism": 2, "tradition": 1, "refinement": 2, "minimalism": -2, "architecture": 2 } },
  { "id": 72, "category": "architecture", "cluster": "low-dark-rooms", "text": "Jeg føler meg best i rom med lavt tak og lite lys.", "dimensions": { "comfort": 2, "solitude": 2, "darkness": 2, "mystery": 1, "architecture": 1 } },
  { "id": 73, "category": "architecture", "cluster": "glass-open", "text": "Store glassflater og åpne planløsninger er idealet mitt.", "dimensions": { "modernity": 3, "minimalism": 2, "order": 2, "optimism": 1, "architecture": 2, "darkness": -1 } },
  { "id": 74, "category": "architecture", "cluster": "full-home", "text": "Et hjem bør være fullt av ting man er glad i, ikke ryddet ned til det nødvendige.", "dimensions": { "maximalism": 3, "comfort": 2, "nostalgia": 1, "minimalism": -3, "ornament": 1 } },
  { "id": 75, "category": "architecture", "cluster": "building-detail-eye", "text": "Jeg legger merke til hvordan bygninger møter bakken og himmelen.", "dimensions": { "architecture": 3, "intellect": 2, "refinement": 1 } },
  { "id": 76, "category": "architecture", "cluster": "winding-streets", "text": "Trange, kronglete gater er mer sjarmerende enn brede, planlagte.", "dimensions": { "history": 2, "chaos": 2, "mystery": 2, "urban": 2, "order": -2 } },
  { "id": 77, "category": "architecture", "cluster": "symmetry", "text": "Symmetri gjør meg rolig.", "dimensions": { "order": 3, "refinement": 2, "minimalism": 1, "chaos": -2 } },
  { "id": 78, "category": "architecture", "cluster": "vernacular", "text": "Jeg liker bygninger som ser ut som de hører til stedet de står på.", "dimensions": { "organic": 2, "tradition": 2, "craft": 1, "architecture": 2, "rural": 1 } },
  { "id": 79, "category": "architecture", "cluster": "bare-room", "text": "Et rom med bare det nødvendige i seg føles fritt, ikke tomt.", "dimensions": { "minimalism": 3, "order": 2, "modernity": 1, "maximalism": -3, "ornament": -1 } },
  { "id": 80, "category": "architecture", "cluster": "abandoned", "text": "Jeg blir tiltrukket av forlatte bygninger.", "dimensions": { "mystery": 3, "history": 2, "darkness": 2, "melancholy": 2, "adventure": 2, "modernity": -1 } },
  { "id": 81, "category": "architecture", "cluster": "skyscrapers", "text": "Høyhus og skyskrapere gir meg en følelse av muligheter.", "dimensions": { "urban": 3, "modernity": 2, "futurism": 2, "optimism": 1, "architecture": 1, "rural": -1 } },
  { "id": 82, "category": "architecture", "cluster": "home-as-cave", "text": "Jeg vil ha et hjem som føles som en hule, ikke som et utstillingsvindu.", "dimensions": { "comfort": 3, "solitude": 2, "darkness": 1, "refinement": -1, "minimalism": -1 } },
  { "id": 83, "category": "architecture", "cluster": "institutions", "text": "Institusjonelle bygninger — bibliotek, universitet, gamle skoler — har en spesiell tiltrekning på meg.", "dimensions": { "intellect": 3, "history": 2, "tradition": 2, "architecture": 2, "refinement": 1, "order": 1 } },
  { "id": 84, "category": "architecture", "cluster": "clash-interior", "text": "Jeg liker interiør der farger, mønstre og epoker kolliderer.", "dimensions": { "maximalism": 3, "chaos": 2, "whimsy": 2, "individualism": 1, "minimalism": -2, "order": -2 } },
  { "id": 85, "category": "architecture", "cluster": "function-first", "text": "Praktisk funksjon betyr mer for meg enn hvordan noe ser ut.", "dimensions": { "realism": 3, "ornament": -2, "refinement": -2, "order": 1 } },
  { "id": 86, "category": "architecture", "cluster": "remote-cabin", "text": "Jeg drømmer om et lite sted helt for meg selv, langt fra andre hus.", "dimensions": { "solitude": 3, "rural": 2, "nature": 2, "comfort": 2, "social": -2 } },
  { "id": 87, "category": "architecture", "cluster": "airy-light", "text": "Lyse, luftige rom med naturmaterialer og få farger er idealet mitt.", "dimensions": { "minimalism": 3, "order": 2, "organic": 2, "optimism": 1, "refinement": 2, "maximalism": -2, "darkness": -2 } },

  { "id": 88, "category": "social", "cluster": "crowd-energy", "text": "Jeg får energi av å være blant mange mennesker.", "dimensions": { "social": 3, "urban": 2, "community": 1, "solitude": -3 } },
  { "id": 89, "category": "social", "cluster": "small-evenings", "text": "De beste kveldene mine er små, med få folk og lange samtaler.", "dimensions": { "community": 2, "intellect": 2, "comfort": 2, "social": -1, "refinement": 1 } },
  { "id": 90, "category": "social", "cluster": "alone-activities", "text": "Jeg trives med å gjøre ting alene som andre helst gjør sammen.", "dimensions": { "solitude": 3, "individualism": 3, "social": -2 } },
  { "id": 91, "category": "social", "cluster": "belonging-group", "text": "Å tilhøre en gruppe med felles interesser betyr mye for meg.", "dimensions": { "community": 3, "social": 2, "tradition": 1, "individualism": -1 } },
  { "id": 92, "category": "social", "cluster": "stand-out", "text": "Jeg vil heller skille meg ut enn å passe inn.", "dimensions": { "individualism": 3, "chaos": 1, "whimsy": 1, "tradition": -2, "community": -1 } },
  { "id": 93, "category": "social", "cluster": "same-days", "text": "Jeg har det best når dagene mine ligner litt på hverandre.", "dimensions": { "order": 3, "comfort": 2, "tradition": 2, "chaos": -2, "adventure": -2 } },
  { "id": 94, "category": "social", "cluster": "alone-among-people", "text": "Jeg liker steder der jeg kan være alene blant folk — kafeer, tog, bibliotek.", "dimensions": { "urban": 2, "solitude": 2, "melancholy": 1, "intellect": 1 } },
  { "id": 95, "category": "social", "cluster": "neighbourhood", "text": "Å hjelpe naboer og kjenne folk i nærmiljøet er viktig for meg.", "dimensions": { "community": 3, "tradition": 2, "rural": 1, "individualism": -1 } },
  { "id": 96, "category": "social", "cluster": "leave-parties", "text": "Jeg blir fort lei av selskaper og vil hjem.", "dimensions": { "solitude": 3, "social": -3, "comfort": 1 } },
  { "id": 97, "category": "social", "cluster": "parties-noise", "text": "Fester, folkemengder og bråk er en del av det jeg liker best med livet.", "dimensions": { "social": 3, "chaos": 2, "urban": 2, "maximalism": 1, "solitude": -3 } },
  { "id": 98, "category": "social", "cluster": "few-confidants", "text": "Jeg deler helst interessene mine med noen få, ikke med alle.", "dimensions": { "solitude": 2, "individualism": 2, "intellect": 1, "social": -1 } },
  { "id": 99, "category": "social", "cluster": "role-in-community", "text": "Å ha en rolle i et fellesskap gir livet mening.", "dimensions": { "community": 3, "tradition": 2, "social": 2, "individualism": -2 } },
  { "id": 100, "category": "social", "cluster": "self-determination", "text": "Jeg vil helst bestemme selv, selv om det betyr å gjøre ting vanskeligere.", "dimensions": { "individualism": 3, "adventure": 1, "chaos": 1, "community": -2 } },
  { "id": 101, "category": "social", "cluster": "being-cared-for", "text": "Jeg liker godt å bli tatt vare på av andre.", "dimensions": { "community": 2, "comfort": 2, "social": 1, "individualism": -2 } },
  { "id": 102, "category": "social", "cluster": "learned-solitude", "text": "Ensomhet er noe jeg har lært å like.", "dimensions": { "solitude": 3, "melancholy": 2, "individualism": 2, "social": -2 } },

  { "id": 103, "category": "mystery", "cluster": "unexplained-stories", "text": "Jeg liker best historier som ikke får en fullstendig forklaring.", "dimensions": { "mystery": 3, "fantasy": 1, "realism": -2, "order": -1 } },
  { "id": 104, "category": "mystery", "cluster": "superstition", "text": "Overtro og gamle skikker er sjarmerende, selv om jeg ikke tror på dem.", "dimensions": { "mystery": 2, "tradition": 2, "fantasy": 2, "whimsy": 1, "history": 1 } },
  { "id": 105, "category": "mystery", "cluster": "other-worlds", "text": "Jeg tenker mye på hvordan andre verdener kunne sett ut.", "dimensions": { "fantasy": 3, "whimsy": 1, "mystery": 2, "realism": -2 } },
  { "id": 106, "category": "mystery", "cluster": "explanations", "text": "Jeg vil vite hvordan ting faktisk henger sammen, ikke hva de kunne betydd.", "dimensions": { "realism": 3, "intellect": 2, "fantasy": -2, "mystery": -2 } },
  { "id": 107, "category": "mystery", "cluster": "scary-comfort", "text": "Skumle historier gir meg en behagelig følelse, ikke ubehag.", "dimensions": { "darkness": 3, "mystery": 2, "comfort": 1, "optimism": -1 } },
  { "id": 108, "category": "mystery", "cluster": "unexplained-world", "text": "Jeg tror det finnes ting i verden vi ikke har forklart ennå.", "dimensions": { "mystery": 3, "fantasy": 2, "realism": -1 } },
  { "id": 109, "category": "mystery", "cluster": "dreams-memory", "text": "Drømmer og halvglemte minner er en viktig kilde til hvordan jeg ser verden.", "dimensions": { "fantasy": 2, "nostalgia": 2, "mystery": 2, "melancholy": 1, "realism": -1 } },
  { "id": 110, "category": "mystery", "cluster": "odd-humour", "text": "Jeg liker humor som er rar og uforutsigbar.", "dimensions": { "whimsy": 3, "chaos": 2, "individualism": 1, "refinement": -1 } },
  { "id": 111, "category": "mystery", "cluster": "wrong-places", "text": "Steder som føles litt feil, uten at jeg kan si hvorfor, fascinerer meg.", "dimensions": { "mystery": 3, "darkness": 2, "chaos": 1, "fantasy": 1, "realism": -1 } },
  { "id": 112, "category": "mystery", "cluster": "collecting", "text": "Jeg samler på småting andre ville kastet.", "dimensions": { "whimsy": 2, "maximalism": 2, "nostalgia": 2, "craft": 1, "minimalism": -2 } },
  { "id": 113, "category": "mystery", "cluster": "ritual-calm", "text": "Symboler, ritualer og gjentakelse gir meg ro.", "dimensions": { "tradition": 2, "mystery": 2, "order": 2, "refinement": 1 } },
  { "id": 114, "category": "mystery", "cluster": "nonfiction", "text": "Jeg vil heller lese en faktabok enn en roman.", "dimensions": { "intellect": 2, "realism": 3, "fantasy": -2 } },
  { "id": 115, "category": "mystery", "cluster": "moonlight", "text": "Månelys, skygger og ting som bare halvt kan skimtes er vakkert.", "dimensions": { "darkness": 2, "mystery": 3, "melancholy": 1, "fantasy": 1 } },
  { "id": 116, "category": "mystery", "cluster": "childlike", "text": "Jeg tror det er sunt å beholde litt barnlighet.", "dimensions": { "whimsy": 3, "optimism": 2, "fantasy": 2, "refinement": -1 } },
  { "id": 117, "category": "mystery", "cluster": "observer", "text": "Jeg føler meg noen ganger som en tilskuer til min egen tid.", "dimensions": { "melancholy": 3, "solitude": 2, "mystery": 1, "nostalgia": 1 } },

  { "id": 118, "category": "order", "cluster": "planning", "text": "Jeg planlegger gjerne ferier i detalj.", "dimensions": { "order": 3, "comfort": 1, "chaos": -2, "adventure": -1 } },
  { "id": 119, "category": "order", "cluster": "unplanned-best", "text": "De beste tingene i livet mitt har skjedd uten planlegging.", "dimensions": { "chaos": 3, "adventure": 2, "optimism": 1, "order": -2 } },
  { "id": 120, "category": "order", "cluster": "mess-unease", "text": "Rot rundt meg gjør meg urolig.", "dimensions": { "order": 3, "minimalism": 2, "chaos": -3, "maximalism": -1 } },
  { "id": 121, "category": "order", "cluster": "creative-mess", "text": "Jeg jobber best når det er litt uorden rundt meg.", "dimensions": { "chaos": 3, "individualism": 1, "craft": 1, "order": -2, "maximalism": 1 } },
  { "id": 122, "category": "order", "cluster": "rules", "text": "Regler finnes for å følges, ikke for å tolkes.", "dimensions": { "order": 3, "tradition": 2, "individualism": -2, "chaos": -2 } },
  { "id": 123, "category": "order", "cluster": "unfinished", "text": "Jeg liker ting som er litt uferdige.", "dimensions": { "chaos": 2, "craft": 2, "organic": 2, "realism": 1, "refinement": -2 } },
  { "id": 124, "category": "order", "cluster": "routines", "text": "Jeg har faste rutiner jeg nødig bryter.", "dimensions": { "order": 3, "tradition": 2, "comfort": 2, "chaos": -2, "adventure": -1 } },
  { "id": 125, "category": "order", "cluster": "light-packing", "text": "Jeg pakker lett og drar gjerne på kort varsel.", "dimensions": { "adventure": 3, "chaos": 2, "minimalism": 2, "comfort": -1, "order": -1 } },
  { "id": 126, "category": "order", "cluster": "perfect-craft", "text": "Perfekt utført håndverk imponerer meg mer enn dristige ideer.", "dimensions": { "craft": 2, "refinement": 3, "order": 2, "chaos": -2 } },
  { "id": 127, "category": "order", "cluster": "everything-its-place", "text": "Jeg liker at ting har en tydelig plass og et tydelig navn.", "dimensions": { "order": 3, "intellect": 1, "minimalism": 1, "chaos": -2 } },
  { "id": 128, "category": "order", "cluster": "travel-unpredictable", "text": "Uforutsigbarhet er den beste delen av å reise.", "dimensions": { "adventure": 3, "chaos": 2, "order": -2, "comfort": -1 } },
  { "id": 129, "category": "order", "cluster": "one-thing-at-a-time", "text": "Jeg fullfører helst én ting før jeg begynner på noe nytt.", "dimensions": { "order": 3, "refinement": 1, "chaos": -2 } },

  { "id": 130, "category": "taste", "cluster": "muted-colours", "text": "Jeg dras mot dempede, jordnære farger framfor sterke og klare.", "dimensions": { "organic": 2, "minimalism": 1, "melancholy": 1, "refinement": 1, "maximalism": -1 } },
  { "id": 131, "category": "taste", "cluster": "clothes-identity", "text": "Klærne mine skal si noe om hvem jeg er, ikke bare kle meg.", "dimensions": { "individualism": 3, "ornament": 2, "refinement": 1, "realism": -1 } },
