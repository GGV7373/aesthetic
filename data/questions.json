  { "id": 134, "category": "taste", "cluster": "contrast", "text": "Jeg liker sterke kontraster: veldig mørkt mot veldig lyst.", "dimensions": { "darkness": 3, "refinement": 1, "mystery": 2, "order": 1 } },
  { "id": 135, "category": "taste", "cluster": "chrome-gloss", "text": "Glans, krom og speilende overflater tiltrekker meg.", "dimensions": { "futurism": 2, "refinement": 2, "digital": 2, "modernity": 2, "organic": -2 } },
  { "id": 136, "category": "taste", "cluster": "pattern-layers", "text": "Jeg liker mønstre, tekstiler og lag på lag.", "dimensions": { "maximalism": 3, "ornament": 3, "comfort": 2, "craft": 1, "minimalism": -3 } },
  { "id": 137, "category": "taste", "cluster": "low-light", "text": "Levende lys og lave lamper er bedre enn taklys.", "dimensions": { "comfort": 3, "darkness": 2, "melancholy": 1, "mystery": 1 } },
  { "id": 138, "category": "taste", "cluster": "beauty-over-provocation", "text": "Jeg blir mest truffet av kunst som er vakker, ikke av kunst som er provoserende.", "dimensions": { "refinement": 3, "ornament": 2, "tradition": 2, "chaos": -2 } },
  { "id": 139, "category": "taste", "cluster": "hardwearing-clothes", "text": "Klær bør se ut som de tåler å bli brukt hardt.", "dimensions": { "craft": 2, "adventure": 2, "realism": 2, "industrial": 1, "refinement": -2 } },
  { "id": 140, "category": "taste", "cluster": "artificial-shine", "text": "Farger som glitrer, skinner og virker litt kunstige er morsomme.", "dimensions": { "whimsy": 3, "digital": 2, "maximalism": 2, "futurism": 1, "organic": -2 } },
  { "id": 141, "category": "taste", "cluster": "light-before-furniture", "text": "Jeg legger merke til lyset i et rom før jeg legger merke til møblene.", "dimensions": { "architecture": 2, "refinement": 2, "mystery": 1, "melancholy": 1 } },

  { "id": 142, "category": "values", "cluster": "transience", "text": "Jeg tenker ofte på at alt jeg ser en dag vil være borte.", "dimensions": { "melancholy": 3, "darkness": 2, "history": 2, "mystery": 1 } },
  { "id": 143, "category": "values", "cluster": "enthusiasm", "text": "Jeg har lett for å bli begeistret.", "dimensions": { "optimism": 3, "whimsy": 2, "social": 1, "melancholy": -2 } },
  { "id": 144, "category": "values", "cluster": "deep-learning", "text": "Å lære noe grundig er en av de største gledene jeg vet om.", "dimensions": { "intellect": 3, "order": 1, "refinement": 1 } },
  { "id": 145, "category": "values", "cluster": "seriousness", "text": "Jeg tar meg selv ganske alvorlig.", "dimensions": { "refinement": 2, "intellect": 2, "order": 1, "whimsy": -3 } },
  { "id": 146, "category": "values", "cluster": "comfort-over-thrill", "text": "Jeg vil heller leve behagelig enn spennende.", "dimensions": { "comfort": 3, "order": 2, "adventure": -3 } },
  { "id": 147, "category": "values", "cluster": "authenticity", "text": "Det er viktigere å være ekte enn å være pen.", "dimensions": { "realism": 3, "individualism": 2, "refinement": -2, "ornament": -2 } },
  { "id": 148, "category": "values", "cluster": "sentimental", "text": "Jeg blir rørt av ting andre synes er sentimentale.", "dimensions": { "nostalgia": 3, "melancholy": 2, "comfort": 1, "whimsy": 1 } },
  { "id": 149, "category": "values", "cluster": "striving", "text": "Jeg liker å ha noe å streve mot, selv om det er slitsomt.", "dimensions": { "adventure": 2, "individualism": 2, "intellect": 1, "comfort": -2 } },
  { "id": 150, "category": "values", "cluster": "world-friendly", "text": "Verden er i bunn og grunn et vennlig sted.", "dimensions": { "optimism": 3, "community": 2, "darkness": -2, "melancholy": -2 } },
  { "id": 151, "category": "values", "cluster": "formality", "text": "Jeg foretrekker folk som er formelle og høflige framfor folk som er direkte og røffe.", "dimensions": { "refinement": 3, "tradition": 2, "order": 2, "chaos": -2 } },
  { "id": 152, "category": "values", "cluster": "sad-and-beautiful", "text": "Jeg trekkes mot ting som er triste og vakre på samme tid.", "dimensions": { "melancholy": 3, "darkness": 2, "refinement": 2, "mystery": 1 } },
  { "id": 153, "category": "values", "cluster": "hands-rest", "text": "Jeg gjør helst ting med hendene når jeg vil koble av.", "dimensions": { "craft": 3, "organic": 1, "comfort": 1, "digital": -2 } },
  { "id": 154, "category": "tech", "cluster": "no-diy", "text": "Jeg har verken tid eller interesse for å lage ting selv.", "dimensions": { "craft": -3, "modernity": 1, "comfort": 1, "individualism": -1 } },
  { "id": 155, "category": "values", "cluster": "gut-feeling", "text": "Jeg stoler mer på magefølelsen enn på grundig research.", "dimensions": { "intellect": -3, "whimsy": 1, "fantasy": 1, "chaos": 1 } },
  { "id": 156, "category": "architecture", "cluster": "rooms-invisible", "text": "Jeg legger sjelden merke til hvordan et rom er utformet.", "dimensions": { "architecture": -3, "ornament": -1, "refinement": -1, "realism": 1 } }
