          "id": 9302,
          "group": "goth",
          "cluster": "goth-2",
          "text": "Lace, velvet and heavy brocade are what I'd wear every day.",
          "dimensions": {
            "ornament": 2,
            "refinement": 1,
            "history": 1,
            "minimalism": -1
          }
        },
        {
          "id": 9303,
          "group": "goth",
          "cluster": "goth-3",
          "text": "I'd pick black, sharp and simple over anything frilly.",
          "dimensions": {
            "minimalism": 2,
            "modernity": 1,
            "ornament": -2
          }
        },
        {
          "id": 9304,
          "group": "goth",
          "cluster": "goth-4",
          "text": "Neon hair, goggles and a dark rave sound like a good night out.",
          "dimensions": {
            "futurism": 2,
            "digital": 2,
            "urban": 1
          }
        },
        {
          "id": 9305,
          "group": "goth",
          "cluster": "goth-5",
          "text": "Cute things with a creepy twist are my favourite.",
          "dimensions": {
            "whimsy": 2,
            "fantasy": 1,
            "darkness": 1
          }
        },
        {
          "id": 9306,
          "group": "goth",
          "cluster": "goth-6",
          "text": "Hanging out at the mall in band shirts was the best.",
          "dimensions": {
            "nostalgia": 2,
            "retro": 1,
            "urban": 1
          }
        },
        {
          "id": 9307,
          "group": "goth",
          "cluster": "goth-7",
          "text": "Post-punk records and a dark club with my friends sound perfect.",
          "dimensions": {
            "community": 2,
            "retro": 2,
            "urban": 1,
            "social": 1
          }
        },
        {
          "id": 9308,
          "group": "goth",
          "cluster": "goth-8",
          "text": "Hot, slow summers in old small towns feel haunted to me.",
          "dimensions": {
            "rural": 2,
            "history": 1,
            "mystery": 1
          }
        },
        {
          "id": 9309,
          "group": "goth",
          "cluster": "goth-9",
          "text": "Poems about love and death move me more than happy songs.",
          "dimensions": {
            "melancholy": 2,
            "fantasy": 1,
            "darkness": 1,
            "optimism": -1
          }
        },
        {
          "id": 9310,
          "group": "goth",
          "cluster": "goth-10",
          "text": "Crystals, tarot cards and a cosy cluttered room feel like me.",
          "dimensions": {
            "mystery": 2,
            "whimsy": 1,
            "ornament": 1,
            "comfort": 1
          }
        },
        {
          "id": 9311,
          "group": "goth",
          "cluster": "goth-11",
          "text": "The past was more beautiful than the present.",
          "dimensions": {
            "history": 2,
            "nostalgia": 1,
            "modernity": -2
          }
        },
        {
          "id": 9312,
          "group": "goth",
          "cluster": "goth-12",
          "text": "The future should look dark and high-tech.",
          "dimensions": {
            "futurism": 2,
            "technology": 1,
            "darkness": 1,
            "history": -1
          }
        },
        {
          "id": 9313,
          "group": "goth",
          "cluster": "goth-13",
          "text": "I'd rather stand out than fit in.",
          "dimensions": {
            "individualism": 2
          }
        },
        {
          "id": 9314,
          "group": "goth",
          "cluster": "goth-14",
          "text": "Cities feel more like home than the countryside.",
          "dimensions": {
            "urban": 2,
            "rural": -2,
            "nature": -1
          }
        },
        {
          "id": 9315,
          "group": "goth",
          "cluster": "goth-15",
          "text": "Graveyards and cathedrals are calming places for me.",
          "dimensions": {
            "architecture": 2,
            "history": 1,
            "darkness": 1,
            "solitude": 1
          }
        },
        {
          "id": 9316,
          "group": "goth",
          "cluster": "goth-16",
          "text": "A little colour and fun never hurt a dark outfit.",
          "dimensions": {
