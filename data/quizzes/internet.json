{
  "key": "internet",
  "title": "Which internet aesthetic are you?",
  "family": "Internet and Liminal",
  "members": [
    "frutiger-aero", "frutiger-eco", "vectordelia", "abstract-tech", "bright-tertiaries",
    "dorfic", "frutevil-aero", "technozen", "y2k", "y2k-futurism",
